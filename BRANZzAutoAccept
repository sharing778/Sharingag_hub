local function parseTime(str)
    local num, unit = str:match("^(%d+)([smhSMH]?)$")
    num  = tonumber(num) or 60
    unit = unit and unit:lower() or "s"
    if unit == "m" then return num * 60
    elseif unit == "h" then return num * 3600
    else return num end
end

