local BAD_KEYWORDS = {
    "star","background","banner","logo","wiki_","button","badge",
    "fundo","placeholder","cursor","arrow","wordmark","favicon",
    "navicon","header","footer","spotlight","ad_","advert","transparent",
    "question","default","noimage","blank",
}

local function isBadImage(url)
    if not url or url == "" then return true end
    local low = url:lower()
    for _, kw in ipairs(BAD_KEYWORDS) do
        if low:find(kw, 1, true) then return true end
    end
    local px = low:match("/(%d+)px%-")
    if px and tonumber(px) < 150 then return true end
    return false
end

local function fetchFandomImage(name)
    local url  = nil
    local done = false

    local v1 = name:gsub("(%a)([%w]*)", function(a,b) return a:upper()..b:lower() end):gsub(" ","_")
    local v2 = name:gsub(" ","_")
    local v3 = name:lower():gsub(" ","_")
    local bestVariant = v1

    task.spawn(function()
        if done then return end
        for _, v in ipairs({v1, v2, v3}) do
            if done then break end
            pcall(function()
                local res = httpGet(WIKI_API.."?action=query&titles="..v.."&prop=pageimages&format=json&pithumbsize=600&piprop=original|thumbnail")
                if done or not res or not res.Body then return end
                if res.Body:find('"missing"') then return end
                local orig = res.Body:match('"original":%s*{.-"source":%s*"([^"]+)"')
                if orig and not isBadImage(orig) then done=true; url=orig:gsub("\\",""); return end
                local thumb = res.Body:match('"thumbnail":%s*{.-"source":%s*"([^"]+)"')
                if thumb and not isBadImage(thumb) then done=true; url=thumb:gsub("\\","") end
            end)
        end
    end)

    task.spawn(function()
        if done then return end
        pcall(function()
            local q = name:gsub(" ","%%20")
            local res = httpGet("https://stealabrainrot.fandom.com/api/v1/Search/List?query="..q.."&limit=3&namespaces=0")
            if done or not res or not res.Body then return end
            local id = res.Body:match('"id":%s*(%d+)')
            if not id then return end
            local r2 = httpGet("https://stealabrainrot.fandom.com/api/v1/Articles/Details?ids="..id.."&abstract=0&width=600&height=600")
            if done or not r2 or not r2.Body then return end
            for img in r2.Body:gmatch('"thumbnail":"(https://[^"]+)"') do
                local c = img:gsub("\\",""):match("^([^?]+)")
                if c and not isBadImage(c) then done=true; url=c; break end
            end
        end)
    end)

    task.spawn(function()
        if done then return end
        pcall(function()
            local res = httpGet(FANDOM_BASE..bestVariant)
            if done or not res or not res.Body then return end
            local body = res.Body
            local cands = {}
            for img in body:gmatch('data%-src="(https://static%.wikia%.nocookie%.net/stealabrainrot/images/[^"]+)"') do
                local c = img:gsub("&amp;","&"):match("^([^?]+)")
                if c and not isBadImage(c) then table.insert(cands, c) end
            end
            if #cands == 0 then
                for img in body:gmatch('src="(https://static%.wikia%.nocookie%.net/stealabrainrot/images/[^"]+)"') do
                    local c = img:gsub("&amp;","&"):match("^([^?]+)")
                    if c and not isBadImage(c) then table.insert(cands, c) end
                end
            end
            if done then return end
            for _, c in ipairs(cands) do
                if c:find("/revision/latest") and not c:find("scale%-to%-width") then
                    done=true; url=c; return
                end
            end
            if #cands > 0 and not done then done=true; url=cands[1] end
        end)
    end)

    task.spawn(function()
        if done then return end
        pcall(function()
            local res = httpGet(WIKI_API.."?action=query&titles="..bestVariant.."&prop=images&format=json&imlimit=10")
            if done or not res or not res.Body then return end
            if res.Body:find('"missing"') then return end
            for fname in res.Body:gmatch('"title":"(File:[^"]+)"') do
                if done then break end
                if not isBadImage(fname) then
                    pcall(function()
                        local r2 = httpGet(WIKI_API.."?action=query&titles="..(fname:gsub(" ","_")).."&prop=imageinfo&iiprop=url&format=json")
                        if done or not r2 or not r2.Body then return end
                        local imgUrl = r2.Body:match('"url":"(https://[^"]+)"')
                        if imgUrl and not isBadImage(imgUrl) then done=true; url=imgUrl:gsub("\\","") end
                    end)
                end
            end
        end)
    end)

    local waited = 0
    while not done and waited < 5 do
        task.wait(0.05)
        waited = waited + 0.05
    end

    if url then print("[IMG] ✅ "..url) else print("[IMG] ❌ Não encontrada: "..name) end
    return url
end

